{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
      },
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": true,
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "ConnectionStrings": {
    "NfeDb": "Server=localhost,1433;Database=NfeMvp;Uid=SA;Pwd=SqlServer2019!;TrustServerCertificate=True",
    "RedisDb": "localhost:6379"
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "WorkerCount": 2,
    "Queues": [ "default" ]
  }
  ,
  "Observability": {
    "ServiceName": "Nfc.Api",
    "SeqUrl": "http://localhost:5341",
    "OtlpEndpoint": "http://localhost:4318"
  },
  "ExportFileStorage": {
    "Provider": "S3",
    "Local": {
      "Directory": "exports"
    },
    "S3": {
      "Bucket": "my-dev-exports",
      "Region": "us-east-1",
      "BaseUrl": "http://localhost:4566/my-dev-exports",
      "ServiceUrl": "http://localhost:4566",
      "AccessKey": "test",
      "SecretKey": "test",
      "PresignExpiryMinutes": 60
    }
  }
}
